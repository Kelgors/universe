generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FederationPlayerTransferState {
  WAITING_TARGET_APPROVAL
  APPROVED_BY_TARGET
  SNAPSHOT_SENT_TO_TARGET
  SNAPSHOT_STAGED_BY_TARGET
  COMMIT_SENT_TO_TARGET
  ACTIVE
  REJECTED_BY_TARGET_AT_INIT
  REJECTED_BY_TARGET_AT_SNAPSHOT
  ABORTED_BY_SOURCE
  ABORTED_BY_TARGET
  EXPIRED
}

model FederationPlayerTransfer {
  id             String                        @id @default(uuid())
  requestId      String
  playerId       String
  state          FederationPlayerTransferState
  cause          String?
  sourceSystemId String
  targetSystemId String
  snapshot       Bytes?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requestId])
}

model FederationEvent {
  id        String @id @default(uuid())
  nodeId    String
  eventType String
  payload   Bytes
  signature Bytes

  createdAt DateTime @default(now())
}
